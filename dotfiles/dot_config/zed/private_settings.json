// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // LSP & Languages
  "lsp": {
    "biome": {},
    "rust-analyzer": {
      "binary": {
        "path": "rust-analyzer",
      },
    },
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd"], // we do not use nil
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": [],
        },
      },
    },
  },
  // Theme & UI
  "which_key": {
    "enabled": true,
  },
  "use_system_window_tabs": false,
  "terminal": {
    "show_count_badge": false,
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "proxy": "",
  "completion_menu_scrollbar": "auto",
  "sticky_scroll": {
    "enabled": true,
  },
  "text_rendering_mode": "platform_default",
  "agent_ui_font_size": 15.0,
  "ui_font_weight": 500.0,
  "buffer_font_weight": 400.0,
  "minimum_split_diff_width": 100.0,
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "middle_click_paste": false,
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware",
  },
  "colorize_brackets": true,
  "inlay_hints": {
    "enabled": true,
  },
  "file_types": {
    "JSONC": [
      // they often use jsonc with .json ext
      "settings.json",
      "private_settings.json", // chezmoi private
    ],
  },
  "experimental.theme_overrides": {
    // TODO: remove, they are experimental
    "editor.indent_guide_cycle": ["#ff000033", "#00ff0033", "#0000ff33"],
    "editor.indent_guide_cycle_active": ["#ff000066", "#00ff0066", "#0000ff66"],
    "editor.indent_guide_background_cycle": [
      "#ff00001a",
      "#00ff001a",
      "#0000ff1a",
    ],
    "editor.indent_guide_background_cycle_active": [
      "#ff000033",
      "#00ff0033",
      "#0000ff33",
    ],
  },
  "code_lens": "on",
  "format_on_save": "off",
  "diagnostics": {
    "inline": {
      "min_column": 0,
    },
  },
  "buffer_font_family": "Maple Mono NF CN",
  "ui_font_fallbacks": [".SystemUIFont"],
  "buffer_font_fallbacks": ["Menlo", ".ZedMono"],
  "ui_font_size": 16.0,
  "buffer_font_size": 15,
  "icon_theme": {
    "mode": "dark",
    "light": "Symbols Icon Theme",
    "dark": "Symbols Icon Theme",
  },
  "theme": {
    "mode": "dark",
    "light": "Pierre Light",
    "dark": "Pierre Dark",
  },
  // Misc
  "autosave": "on_focus_change",
  "diff_view_style": "split",
  "edit_predictions": {
    "provider": "zed",
    "allow_data_collection": "no",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "tabs": {
    "git_status": true,
  },
  "title_bar": {
    "show_menus": true, // Make linux/windows integrate menus with titlebar
    "show_branch_status_icon": true,
  },
  "minimap": {
    "show": "always",
  },
  "git_panel": {
    "show_count_badge": false,
    "file_icons": false,
    "entry_primary_click_action": "file_diff",
    "tree_view": false,
    "dock": "left",
  },
  "project_panel": {
    "git_status": true,
    "git_status_indicator": true,
    "diagnostic_badges": false,
    "bold_folder_labels": false,
    "dock": "left",
  },
  "wrap_guides": [72, 80, 100, 120],
  // AI Agent Config
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "effort": "high",
        "model": "deepseek/deepseek-v4-flash",
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
    },
  },
  "agent": {
    "default_profile": "write",
    "commit_message_instructions": "If multiple changes are included, list each one briefly within 50 characters.",
    "show_turn_stats": true,
    "thinking_display": "always_expanded",
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "enable_thinking": true,
      "effort": "high",
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  // Extensions
  "auto_install_extensions": {
    "astro": true,
    "biome": true,
    "catppuccin": false,
    "catppuccin-icons": false,
    "catppuccin-blur": false,
    "comment": true,
    "dart": false,
    "discord-presence": true,
    "dockerfile": true,
    "docker-compose": true,
    "emmet": true,
    "fish": true,
    "gdscript": true,
    "glsl": true,
    "gotmpl": true,
    "git-firefly": true,
    "java": false,
    "json5": false,
    "just": true,
    "lua": true,
    "luau": false,
    "log": true,
    "ini": true,
    "kotlin": false,
    "make": true,
    "mermaid": true,
    "material-icon-theme": true,
    "nix": true,
    "nu": true,
    "oxc": true,
    "pierre-theme": true,
    "powershell": true,
    "proto": true,
    "rainbow-csv": true,
    "scss": true,
    "sql": true,
    "svelte": true,
    "swift": false,
    "ssh-config": true,
    "symbols": true,
    "toml": true,
    "typos": true,
    "vue": true,
    "wakatime": true,
    "xml": true,
    "zig": false,
  },
}
