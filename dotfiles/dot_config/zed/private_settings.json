{
  // Big build/dependency trees: keep them out of Zed's file scan & watcher.
  // NOTE: setting this overrides Zed's defaults, so the default globs must be repeated here.
  "hover_popover_delay": 200,
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/target",
    "**/node_modules",
    "**/.venv",
    "**/__pycache__",
  ],
  // LSP & Languages
  "auto_indent_on_paste": false,
  "gutter": {},
  "buffer_line_height": {
    "custom": 1.399999976158142,
  },
  "show_edit_predictions": false,
  "helix_mode": false,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "relative_line_numbers": "disabled",
  "collaboration_panel": {
    "button": false,
  },
  "context_servers": {
    "godot": {
      "enabled": true,
      "remote": false,
      "command": "bunx",
      "args": ["@coding-solo/godot-mcp"],
      "env": {
        "GODOT_PATH": "/Applications/Godot.app/Contents/MacOS/Godot",
      },
    },
    "nixos": {
      "enabled": true,
      "remote": false,
      "command": "uvx",
      "args": ["mcp-nixos"],
    },
    "mediawiki": {
      "enabled": true,
      "remote": false,
      "command": "bunx",
      "args": ["-y", "@professional-wiki/mediawiki-mcp-server@latest"],
    },
    "deepwiki": {
      "enabled": true,
      "url": "https://mcp.deepwiki.com/mcp",
    },
  },
  "soft_wrap": "prefer_line",
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
    "rust-analyzer": {
      "binary": {
        "path": "rust-analyzer",
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "referencesCodeLens": {
            "enabled": false,
            "showOnAllFunctions": false,
          },
          "inlayHints": {
            "variableTypes": {
              "enabled": false,
            },
            "functionLikeReturnTypes": {
              "enabled": false,
            },
          },
        },
        "javascript": {
          "referencesCodeLens": {
            "enabled": false,
            "showOnAllFunctions": false,
          },
          "inlayHints": {
            "variableTypes": {
              "enabled": false,
            },
            "functionLikeReturnTypes": {
              "enabled": false,
            },
          },
        },
      },
    },
  },
  "languages": {
    "TSX": {
      "tab_size": 2,
    },
    "Vue.js": {
      "tab_size": 2,
    },
    "Svelte": {
      "tab_size": 2,
    },
    "SASS": {
      "tab_size": 2,
    },
    "CSS": {
      "tab_size": 2,
    },
    "Go HTML Template": {
      "tab_size": 2,
    },
    "Astro": {
      "tab_size": 2,
    },
    "HTML": {
      "tab_size": 2,
    },
    "Nix": {
      "language_servers": [""], // we do not use nil nor nixd
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": [],
        },
      },
    },
    // make sure oxfmt does not take precedence
    "TOML": {
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "tombi",
          },
        },
      ],
    },
  },
  // Theme & UI
  "which_key": {
    "enabled": true,
  },
  "use_system_window_tabs": false,
  "terminal": {
    "shell": {
      "program": "fish"
    },
    "font_size": 12.0,
    "show_count_badge": false,
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "proxy": "",
  "completion_menu_scrollbar": "auto",
  "sticky_scroll": {
    "enabled": true,
  },
  "text_rendering_mode": "platform_default",
  "agent_ui_font_size": 15.0,
  "buffer_font_weight": 400.0,
  "minimum_split_diff_width": 100.0,
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "middle_click_paste": false,
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware",
  },
  "colorize_brackets": true,
  "inlay_hints": {
    "enabled": true,
  },
  "file_types": {
    "JSONC": [
      // they often use jsonc with .json ext
      "settings.json",
      "private_settings.json", // chezmoi private
    ],
  },
  "experimental.theme_overrides": {
    // TODO: remove, they are experimental
    "editor.indent_guide_cycle": ["#ff000033", "#00ff0033", "#0000ff33"],
    "editor.indent_guide_cycle_active": ["#ff000066", "#00ff0066", "#0000ff66"],
    "editor.indent_guide_background_cycle": [
      "#ff00001a",
      "#00ff001a",
      "#0000ff1a",
    ],
    "editor.indent_guide_background_cycle_active": [
      "#ff000033",
      "#00ff0033",
      "#0000ff33",
    ],
  },
  "code_lens": "on",
  "format_on_save": "off",
  "diagnostics": {
    "inline": {
      "min_column": 0,
    },
  },
  "buffer_font_family": "Maple Mono NF CN",
  "ui_font_fallbacks": [".SystemUIFont"],
  "buffer_font_fallbacks": ["Menlo", ".ZedMono"],
  "ui_font_size": 15.0,
  "buffer_font_size": 12.0,
  "icon_theme": {
    "mode": "dark",
    "light": "Symbols Icon Theme",
    "dark": "Symbols Icon Theme",
  },
  "theme": {
    "mode": "dark",
    "light": "Pierre Light",
    "dark": "Gruvbox Dark",
  },
  // Misc
  "autosave": "on_focus_change",
  "diff_view_style": "split",
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
    "open_ai_compatible_api": {
      "model": "",
    },
    "provider": "zed",
    "allow_data_collection": "no",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "tabs": {
    "git_status": true,
  },
  "title_bar": {
    "show_menus": true, // Make linux/windows integrate menus with titlebar
    "show_branch_status_icon": true,
  },
  "minimap": {
    "show": "always",
  },
  "git_panel": {
    "group_by": "staging",
    "show_count_badge": false,
    "file_icons": false,
    "entry_primary_click_action": "file_diff",
    "tree_view": false,
    "dock": "left",
  },
  "project_panel": {
    "git_status": true,
    "git_status_indicator": true,
    "diagnostic_badges": false,
    "bold_folder_labels": false,
    "dock": "left",
  },
  "wrap_guides": [72, 80, 100, 120],
  // AI Agent Config
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "effort": "high",
        "model": "deepseek/deepseek-v4-flash",
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
    },
  },
  "agent": {
    "terminal_init_command": "pi",
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "auto_compact": {
      "threshold": 9999999999,
    },
    "sidebar_side": "right",
    "enable_feedback": false,
    "tool_permissions": {
      "tools": {
        "mcp:mcp-server-context7:resolve-library-id": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
        },
        "write_file": {
          "default": "allow",
        },
        "move_path": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^https?://town-of-salem\\.fandom\\.com"
            },
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            },
            {
              "pattern": "^https?://atproto\\.com"
            }
          ],
        },
        "mcp:deepwiki:ask_question": {
          "default": "allow",
        },
        "mcp:mcp-server-context7:query-docs": {
          "default": "allow",
        },
        "mcp:mcp-server-exa-search:web_search_exa": {
          "default": "allow",
        },
        "mcp:mediawiki:search-page": {
          "default": "allow",
        },
        "mcp:mediawiki:get-page": {
          "default": "allow",
        },
      },
    },
    "inline_assistant_model": {
      "provider": "opencode",
      "model": "go/mimo-v2.5",
      "enable_thinking": false,
    },
    "default_profile": "write",
    "commit_message_instructions": "Use Conventional Commits. If multiple changes are included, list each one briefly within 50 characters.",
    "show_turn_stats": true,
    "thinking_display": "always_expanded",
    "default_model": {
      "provider": "opencode",
      "model": "go/hy3",
      "enable_thinking": true,
      "effort": "high",
    },
    "dock": "right",
    "favorite_models": [
      {
        "provider": "opencode",
        "model": "go/deepseek-v4-flash",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "opencode",
        "model": "go/deepseek-v4-pro",
        "enable_thinking": true,
        "effort": "max"
      }
    ],
    "model_parameters": [],
  },
  // Extensions
  "auto_install_extensions": {
    "astro": true,
    "biome": true,
    "catppuccin": false,
    "catppuccin-icons": false,
    "catppuccin-blur": false,
    "comment": true,
    "csharp": true,
    "dart": false,
    "discord-presence": true,
    "dockerfile": true,
    "docker-compose": true,
    "emmet": true,
    "fish": true,
    "gdscript": true,
    "glsl": true,
    "gotmpl": true,
    "git-firefly": true,
    "java": true,
    "json5": true,
    "just": true,
    "lua": true,
    "luau": false,
    "log": true,
    "ini": true,
    "kotlin": false,
    "make": true,
    "github-theme": true,
    "mermaid": true,
    "material-icon-theme": true,
    "mcp-server-context7": true,
    "mcp-server-exa-search": true,
    "nix": true,
    "nu": true,
    "oxc": true,
    "pierre-theme": true,
    "powershell": true,
    "po": true,
    "proto": true,
    "rainbow-csv": true,
    "ron": true,
    "scss": true,
    "sql": true,
    "slint": true,
    "svelte": true,
    "swift": false,
    "symbols": true,
    "toml": true,
    "tombi": true,
    "typos": true,
    "vue": true,
    "wakatime": true,
    "wgsl-wesl": true,
    "xml": true,
    "zig": false,
  },
}
