# Config generated by Ghostty Config

custom-shader = shaders/ripple_cursor.glsl
# custom-shader-animation = always

background = #070707
# macos-glass-regular made cursor shader glitchy.
background-blur = true
background-opacity = 0.90
clipboard-paste-protection = true
# cursor-color = #ffffff
# cursor-opacity = 0.95
# bar = |, block = █
cursor-style = block
cursor-text = #070707
font-family = "Maple Mono NF CN"
font-family = "JetBrains Mono"
font-family = "Lantinghei TC"
font-family = "Menlo"
font-family = "Monaco"
font-family = "Courier New"
font-feature = -calt, -liga, -ss08

# it hurts my eye
font-thicken = false

foreground = #fbfbfb
minimum-contrast = 1.2
mouse-hide-while-typing = true
{{/* if ne .chezmoi.os "linux" */}}
palette = 0=#141415
palette = 1=#ff2e3f
palette = 2=#0dbe4e
palette = 3=#ffca00
palette = 4=#009fff
palette = 5=#c635e4
palette = 6=#08c0ef
palette = 7=#c6c6c8
palette = 8=#6c6c71
palette = 9=#ff6762
palette = 10=#5ecc71
palette = 11=#ffd452
palette = 12=#69b1ff
palette = 13=#d568ea
palette = 14=#68cdf2
palette = 15=#fbfbfb
selection-background = #19283c
selection-foreground = #fbfbfb
{{/* end */}}
scrollback-limit = 100000
split-divider-color = #262727
# theme = Pierre Dark
# window-show-tab-bar = always
