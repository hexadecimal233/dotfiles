{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // "opencode-rtk" opt-in
  ],
  "autoupdate": false, // prevent random updater kicking in
  // "model": "deepseek/deepseek-v4-flash",
  // "small_model": "deepseek/deepseek-v4-flash",
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
    },
    "godot": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "@coding-solo/godot-mcp"],
      "environment": {
        // We have to set GODOT_PATH to the executable path
        "DEBUG": "true",
      },
    },

    "mediawiki-mcp-server": {
      "type": "local",
      "command": ["npx", "@professional-wiki/mediawiki-mcp-server@latest"],
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
    },
    "tmux": {
      "type": "local",
      // burning tokens, disabled
      "enabled": false,
      "command": ["uvx", "libtmux-mcp"],
    },
    "taobao": {
      "type": "remote",
      "url": "http://localhost:3654/mcp",
    },
  },
}
