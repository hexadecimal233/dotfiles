{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@latest",
    // "opencode-rtk" opt-in
  ],
  "autoupdate": false, // prevent random updater kicking in
  // "model": "deepseek/deepseek-v4-flash",
  // "small_model": "deepseek/deepseek-v4-flash",
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
    },
    "godot": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "@coding-solo/godot-mcp"],
      "environment": {
        // We have to set GODOT_PATH to the executable path
        "DEBUG": "true",
      },
    },

    "mediawiki-mcp-server": {
      "type": "local",
      "command": ["npx", "@professional-wiki/mediawiki-mcp-server@latest"],
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
    },
    "nixos": {
      "type": "local",
      "command": ["uvx", "mcp-nixos"],
    },
    "tmux": {
      "type": "local",
      // burning tokens, disabled
      "enabled": false,
      "command": ["uvx", "libtmux-mcp"],
    },
    "yt-dlp": {
      "type": "local",
      "command": ["npx", "-y", "@kevinwatt/yt-dlp-mcp@latest"],
    },
    "lazy-mcp": {
      // use if necessary
      "type": "local",
      "enabled": false,
      "command": ["npx", "lazy-mcp@latest"],
    },
  },
  /*
  "lsp": {
    "deno": {
      "disabled": true
    }
  }*/
}
