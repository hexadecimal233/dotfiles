{
  "nix.enableLanguageServer": true,
  "nix.formatterPath": "alejandra",
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "alejandra" // use alejandra instead of nixfmt
        ]
      },
      "options": {
        "home-manager": {
          // use "wsl" as our source for home-manager language features
          "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.wsl.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  }
}