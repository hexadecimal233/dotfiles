// NixOS config project settings
// Formatter: alejandra (per AGENTS.md)
// LSP: nixd
{
  "languages": {
    "Nix": {
      "language_servers": ["nixd"],
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": ["--quiet"]
        }
      },
      "tab_size": 2,
      "preferred_line_length": 80
    }
  }
}
