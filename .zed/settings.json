// NixOS config project settings
// LSP: nixd (config from .vscode/settings.json)
// Formatter: alejandra
{
  "lsp": {
    "nixd": {
      "initialization_options": {
        "formatting": {
          "command": ["alejandra"]
        },
        "options": {
          "nixos-thinkpad": {
            "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.thinkpad.options"
          },
          "nixos-wsl": {
            "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.wsl.options"
          },
          "darwin-neo": {
            "expr": "(builtins.getFlake (builtins.toString ./.)).darwinConfigurations.neo.options"
          },
          "home-manager": {
            "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.thinkpad.options.home-manager.users.type.getSubOptions []"
          }
        }
      }
    }
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd"],
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": []
        }
      },
      "tab_size": 2
    }
  }
}
